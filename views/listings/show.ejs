<% layout("/layouts/boilerplate") -%>
<div class="container mt-2 mb-5">
    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">

            <h3 class="text-center mb-3">
                <i>Details of : <%= listings.title %></i>
            </h3>
            <div class="card shadow-sm">
                <img
                    src="<%= listings.image.url %>"
                    class="card-img-top"
                    alt="Listing Image"
                    style="height:220px; object-fit:cover;">
                <div class="card-body">
                    <p class="card-text">
                        <strong><%= listings.title %></strong><br>
                        <%= listings.description %><br>
                        &#8377;
                        <%= listings.price.toLocaleString("en-IN") %><br>
                        <%= listings.location %><br>
                        <%= listings.country %>
                    </p>
                    <% if(currUser && currUser._id.equals(listings.owner)) { %>
                    <div class="d-flex gap-2 mt-3">
                        <form
                            method="GET"
                            action="/listings/<%= listings._id %>/edit">
                            <button class="btn btn-dark">
                                Edit
                            </button>
                        </form>
                        <form
                            method="POST"
                            action="/listings/<%= listings._id %>?_method=DELETE">
                            <button class="btn btn-danger">
                                Delete
                            </button>
                        </form>
                    </div>
                    <% } %>
                </div>
            </div>

            <hr class="my-4">
            <h4 class="mb-3">
                Leave a Review
            </h4>
            <form action="/listings/<%=listings._id %>/reviews" method="POST">
                <div class="mb-3">
                    <label for="rating" class="form-label">
                        Rating
                    </label>
                    <select
                        name="review[rating]"
                        id="rating"
                        class="form-select">
                        <option selected disabled>
                            Select Rating
                        </option>
                        <option value="1">1 ⭐</option>
                        <option value="2">2 ⭐⭐</option>
                        <option value="3">3 ⭐⭐⭐</option>
                        <option value="4">4 ⭐⭐⭐⭐</option>
                        <option value="5">5 ⭐⭐⭐⭐⭐</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">
                        Comment
                    </label>
                    <textarea
                        name="review[comment]"
                        id="comment"
                        class="form-control"
                        rows="5"
                        placeholder="Write your review here..."></textarea>
                </div>
                <button class="btn btn-dark">
                    Submit Review
                </button>
            </form>

            <hr>

            <% if (listings.reviews && listings.reviews.length > 0) { %>

            <div class="mt-5">

                <h4 class="mb-4">What people are saying</h4>

                <div class="row g-4">

                    <% for (let review of listings.reviews) { %>

                        <div class="col-12 col-md-6">

                            <div class="card border-0 shadow-sm h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center"
                                            style="width: 36px; height: 36px; font-size: 14px; font-weight: 500; flex-shrink: 0;">
                                            <%= review.author ? review.author.username.charAt(0).toUpperCase() : "?" %>
                                        </div>
                                        <div>
                                            <strong>
                                                <%= review.author ? review.author.username : "Anonymous" %>
                                            </strong>
                                            <div class="text-muted small">
                                                Verified recommendation
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <% for(let i = 0; i < review.rating; i++) { %>
                                            ⭐
                                        <% } %>
                                    </div>

                                    <p class="card-text mb-3">
                                        "<%= review.comment %>"
                                    </p>

                                    <small class="text-muted">
                                        <%= review.createdAt.toLocaleDateString("en-IN") %>
                                    </small>

                                </div>

                            </div>

                        </div>

                    <% } %>

                </div>

            </div>

            <% } %>

        </div>
    </div>
</div>